# V3-D344 (2026-05-28): artifacts + secrets excluded before main merge.
# Debug screenshots scattered at repo root (Playwright/manual captures).
/*.png
# Claude/Playwright session + audit artifacts (throwaway, regenerated each run).
_audits/
_backup/
.playwright-mcp/
.agents/
# MCP config contains an API key (OBSIDIAN_API_KEY) — never commit.
.mcp.json
# Design-tooling capture dirs (bulky reference screenshots, regenerated by skills).
public/_pixel-refs/
public/_screenshot-spec/
# External reference clones (have their own .git — would become broken submodules).
_references/

# V3-D451: variant node_modules backups + broken-git backup + env backups + editor scratch.
# These got swept into a bad `git add -A` because the bare `node_modules` rule above only
# matches the exact name, not these variants. NEVER commit (esp. the env files = secrets).
node_modules.nosync/
node_modules_old/
.git.broken*/
.obsidian/
.env.sentry-build-plugin
.env*.bak*
_shot*.cjs
/Untitled*
supabase/.temp/
scratchpad/

# Playwright/verification scratch files. One of these (dated 2026-08-17) sat untracked
# in this worktree for nine days and silently blocked 186 automatic merges, because the
# checkpoint merge refuses to run while main has ANY uncommitted change, untracked included.
.tmp-verify-*
hooks-lint.json
.claude/state/tunnel.log
_tmp_*.mjs

# measurement outputs from scripts/measure (screenshots, json), re-generated on every run
scripts/measure/out/
