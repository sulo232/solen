"Tag hinzufügen...\",\"loading\":\"Laden...\",\"saving\":\"Speichern...\",\"save\":\"Speichern\",\"cancel\":\"Abbrechen\",\"add\":\"Hinzufügen\",\"delete\":\"Löschen\",\"close\":\"Schliessen\",\"no_data\":\"Keine Daten\",\"tab_designs\":\"Designs\",\"tab_hand_chart\":\"Hand Chart\",\"tab_preferences\":\"Präferenzen\",\"tab_inspo\":\"Inspiration\",\"tab_notes\":\"Notizen\",\"tab_tags\":\"Tags\",\"notes_hint\":\"Nutzen Sie den allgemeinen Kunden-Tab für Notizen.\",\"tags_hint\":\"Nutzen Sie den allgemeinen Kunden-Tab für Tags.\",\"inspo_empty\":\"Keine gespeicherten Inspirationen\",\"stations_title\":\"Stationen verwalten\",\"stations_count\":\"Anzahl Stationen\",\"stations_uv_lamps\":\"UV-Lampen\",\"stations_buffer\":\"Sterilisations-Puffer (Min.)\",\"stations_booked\":\"Gebucht\",\"stations_available\":\"Verfügbar\",\"stations_utilization\":\"Aktuelle Auslastung\",\"stations_used_of\":\"{used} von {total} belegt\",\"retail_title\":\"Retail Produkte\",\"retail_new\":\"Neues Produkt\",\"retail_name_placeholder\":\"Produktname\",\"retail_price_placeholder\":\"Preis (CHF)\",\"retail_empty\":\"Noch keine Produkte\",\"retail_products_count\":\"{count} Produkte\",\"retail_cat_nail_care\":\"Nagelpflege\",\"retail_cat_tools\":\"Werkzeug\",\"retail_cat_polish\":\"Nagellack\",\"retail_cat_accessories\":\"Zubehör\",\"retail_cat_hair_care\":\"Haarpflege\",\"retail_cat_skin_care\":\"Hautpflege\",\"retail_cat_styling\":\"Styling\",\"retail_cat_care\":\"Pflege\",\"checkout_title\":\"Kasse\",\"decrease\":\"Weniger\",\"increase\":\"Mehr\",\"checkout_total\":\"Total\",\"checkout_pay\":\"Bezahlen\",\"checkout_processing\":\"Verarbeite...\",\"checkout_success\":\"Verkauf abgeschlossen\",\"pricing_title\":\"Dynamische Preise\",\"pricing_new_rule\":\"Neue Regel\",\"pricing_overview\":\"Preis-Übersicht (Woche)\",\"pricing_factor\":\"Preisfaktor\",\"pricing_preview\":\"Vorschau\",\"pricing_empty\":\"Keine Preisregeln konfiguriert\",\"pricing_peak\":\"Stosszeit\",\"pricing_off_peak\":\"Randzeiten\",\"pricing_weekend\":\"Wochenende\",\"pricing_last_minute\":\"Last Minute\",\"pricing_loyalty\":\"Stammkunden\",\"pricing_all_days\":\"Alle Tage\",\"pricing_to\":\"bis\",\"infill_title\":\"Infill-Erinnerungen\",\"infill_no_services\":\"Keine Nail-Services gefunden\",\"infill_reminder_after\":\"Erinnerung nach\",\"infill_days\":\"Tagen\",\"infill_due_clients\":\"{count} Kunden fällig diese Woche\",\"infill_metrics_title\":\"Letzte 30 Tage\",\"infill_sent\":\"Gesendet\",\"infill_booked\":\"Gebucht\",\"infill_conversion\":\"Conversion\",\"pageTitle\":\"Nagel Verwaltung\",\"tabAI\":\"AI Art\",\"tabGallery\":\"AI Galerie\",\"tabPrices\":\"Preise\",\"tabStations\":\"Stationen\",\"tabRetail\":\"Retail\",\"tabSales\":\"Verkäufe\",\"tabReminders\":\"Erinnerungen\",\"retail_total_revenue\":\"Umsatz\",\"retail_units_sold\":\"Einheiten\",\"retail_avg_sale\":\"Ø Verkauf\",\"retail_top_product\":\"Top-Produkt\",\"retail_weekly_revenue\":\"Wöchentlicher Umsatz\",\"retail_revenue\":\"Umsatz\",\"retail_top_products\":\"Top 5 Produkte\",\"units\":\"Stk.\",\"gallery_title\":\"AI Art Verlauf\",\"gallery_items\":\"Bilder\",\"gallery_empty\":\"Noch keine AI-Bilder generiert\",\"gallery_save\":\"Speichern\",\"gallery_saved\":\"Gespeichert\",\"gallery_unsave\":\"Entfernen\",\"prefs_shape\":\"Bevorzugte Form\",\"prefs_length\":\"Bevorzugte Länge\",\"prefs_material\":\"Bevorzugtes Material\",\"prefs_brand\":\"Lieblingsmarke\",\"prefs_brand_placeholder\":\"z.B. OPI, Essie, CND...\",\"prefs_allergies\":\"Allergien\",\"prefs_allergy_placeholder\":\"z.B. Methacrylat\",\"prefs_severity_mild\":\"Mild\",\"prefs_severity_moderate\":\"Moderat\",\"prefs_severity_severe\":\"Schwer\",\"prefs_allergy_notes_placeholder\":\"Zusätzliche Notizen...\",\"prefs_save\":\"Präferenzen speichern\",\"prefs_no_preference\":\"Keine Präferenz\",\"prefs_shape_round\":\"Rund\",\"prefs_shape_square\":\"Square\",\"prefs_shape_oval\":\"Oval\",\"prefs_shape_almond\":\"Mandel\",\"prefs_shape_coffin\":\"Coffin\",\"prefs_shape_stiletto\":\"Stiletto\",\"prefs_shape_squoval\":\"Squoval\",\"prefs_shape_ballerina\":\"Ballerina\",\"prefs_length_natural\":\"Natürlich\",\"prefs_length_short\":\"Kurz\",\"prefs_length_medium\":\"Mittel\",\"prefs_length_long\":\"Lang\",\"prefs_length_extra_long\":\"Extra Lang\",\"prefs_mat_gel\":\"Gel\",\"prefs_mat_acrylic\":\"Acryl\",\"prefs_mat_dip_powder\":\"Dip Powder\",\"prefs_mat_polygel\":\"Polygel\",\"prefs_mat_shellac\":\"Shellac\",\"timeline_no_designs\":\"Noch keine Designs\",\"timeline_repeat\":\"Wiederholen\",\"timeline_publish\":\"Auf Discovery\",\"timeline_publishing\":\"...\",\"portfolio_empty\":\"Noch keine Designs im Portfolio\",\"day_sun\":\"So\",\"day_mon\":\"Mo\",\"day_tue\":\"Di\",\"day_wed\":\"Mi\",\"day_thu\":\"Do\",\"day_fri\":\"Fr\",\"day_sat\":\"Sa\",\"pricing_discount\":\"Rabatt\",\"pricing_base\":\"Basis\",\"pricing_premium\":\"Premium\",\"retail_low_stock_alert\":\"{count, plural, one {# Produkt mit niedrigem Bestand} other {# Produkte mit niedrigem Bestand}}\",\"retail_stock\":\"Bestand: {count}\",\"retail_stock_minus\":\"Bestand verringern\",\"retail_stock_plus\":\"Bestand erhöhen\",\"retail_cat_label\":\"Kategorie\"},\"makeup\":{\"coming_soon_title\":\"Kommt bald\",\"coming_soon_message\":\"Wir arbeiten daran, diese Kategorie für Sie verfügbar zu machen.\"},\"discoveryFilters\":{\"filter_label\":\"Filter\",\"open_filters\":\"Filter öffnen\",\"refine_search\":\"Suche verfeinern\",\"category\":\"Kategorie\",\"gender\":\"Geschlecht\",\"reset\":\"Zurücksetzen\",\"apply\":\"Anwenden\",\"close\":\"Schliessen\",\"all_styles\":\"Alle Styles\",\"dna_note\":\"Schon auf Ihr Profil abgestimmt, Sie können alles ändern.\",\"hairType\":\"Haartyp\",\"texture_straight\":\"Glatt\",\"texture_wavy\":\"Wellig\",\"texture_curly\":\"Lockig\",\"texture_coily\":\"Coily\",\"sortBy\":\"Sortieren\",\"sort_for_you\":\"Für Sie\",\"sort_new\":\"Neu\",\"sort_popular\":\"Beliebt\",\"dna_subline\":\"Schon auf Sie abgestimmt. Alles änderbar.\",\"dna_heading_with_length\":\"{texture}, {length} Haar\",\"dna_heading_texture_only\":\"{texture} Haar\",\"dna_texture_straight\":\"Glattes\",\"dna_texture_wavy\":\"Welliges\",\"dna_texture_curly\":\"Lockiges\",\"dna_texture_coily\":\"Krauses\",\"dna_texture_protective\":\"Geschütztes\",\"dna_texture_bald\":\"Sehr kurzes\",\"dna_length_short\":\"kurzes\",\"dna_length_medium\":\"schulterlanges\",\"dna_length_long\":\"langes\",\"gender_women\":\"Frauen\",\"gender_men\":\"Männer\",\"gender_unisex\":\"Unisex\",\"cut_for\":\"Schnitt für {texture}\",\"profile_tag\":\"aus Ihrem Profil\"},\"barber_dashboard\":{\"leaderboard_title\":\"Barber Leaderboard\",\"bookings\":\"Buchungen\",\"revenue\":\"Umsatz\",\"retention\":\"Retention\",\"avg_tip\":\"Ø Trinkgeld\",\"walkin_conversion\":\"Walk-in Conv.\",\"chair_utilization\":\"Stuhl-Ausl.\",\"show_names\":\"Namen zeigen\",\"anonymize\":\"Anonymisieren\",\"period_week\":\"Woche\",\"period_month\":\"Monat\",\"loading\":\"Laden...\",\"no_data\":\"Keine Daten\"},\"tour\":{\"next\":\"Weiter →\",\"prev\":\"← Zurück\",\"done\":\"Los geht's!\",\"step1Title\":\"Suchen\",\"step1Desc\":\"Suchen Sie nach Salons, Services oder Stadtteilen — alles auf einen Blick.\",\"step2Title\":\"Kategorien\",\"step2Desc\":\"Chat mit Ihrem Salon, Preise auf der Karte, Stempelkarten \u0026 Last-Minute Deals — nur bei Solen.\",\"step3Title\":\"Buchen\",\"step3Desc\":\"Wählen Sie Ihren Wunschtermin und buchen Sie in wenigen Sekunden — auch Last-Minute mit Rabatt.\"},\"pwa\":{\"title\":\"Installieren Sie Solen\",\"subtitle\":\"Für schnelle Buchungen und Erinnerungen\",\"dismiss\":\"Schliessen\",\"installButton\":\"App installieren\",\"iosInstructions\":\"Tippen Sie auf Teilen → Zum Home-Bildschirm\"},\"legal\":{\"terms\":{\"title\":\"Allgemeine Geschäftsbedingungen\",\"lastUpdated\":\"Zuletzt aktualisiert: März 2026\",\"s1Title\":\"1. Geltungsbereich\",\"s1Body\":\"Diese AGB gelten für die Nutzung der Plattform solen.ch. Durch die Registrierung akzeptieren Sie diese Bedingungen.\",\"s2Title\":\"2. Leistungen\",\"s2Body\":\"Solen.ch vermittelt Buchungen zwischen Kunden und Salons im Raum Basel. Die Plattform stellt die technische Infrastruktur bereit.\",\"s3Title\":\"3. Registrierung\",\"s3Body\":\"Für die Nutzung als Saloninhaber ist eine Registrierung erforderlich. Die Angaben müssen wahrheitsgemäss und vollständig sein.\",\"s4Title\":\"4. Zahlungen\",\"s4Body\":\"Zahlungen werden über Stripe abgewickelt. Solen.ch erhebt eine Plattformgebühr gemäss dem aktuellen Preisplan.\",\"s5Title\":\"5. Haftung\",\"s5Body\":\"Solen.ch haftet nicht für die Qualität der erbrachten Dienstleistungen der Salons. Die Haftung ist auf die Höhe der Plattformgebühr beschränkt.\"},\"privacy\":{\"title\":\"Datenschutzerklärung\",\"lastUpdated\":\"Zuletzt aktualisiert: März 2026\",\"s1Title\":\"1. Verantwortliche Stelle\",\"s1Body\":\"Verantwortlich für die Datenverarbeitung ist solen.ch, Basel, Schweiz.\",\"s2Title\":\"2. Erhobene Daten\",\"s2Body\":\"Wir erheben Name, E-Mail-Adresse, Telefonnummer und Buchungsdaten. Bei Salons zusätzlich Geschäftsadresse und Zahlungsinformationen.\",\"s3Title\":\"3. Verwendung der Daten\",\"s3Body\":\"Ihre Daten werden ausschliesslich zur Erbringung unserer Dienstleistungen verwendet. Wir geben keine Daten an Dritte weiter, ausser zur Zahlungsabwicklung (Stripe).\",\"s4Title\":\"4. Cookies\",\"s4Body\":\"Wir verwenden technisch notwendige Cookies und Analytics-Cookies (PostHog). Sie können Cookies in Ihren Browsereinstellungen deaktivieren.\",\"s5Title\":\"5. Ihre Rechte\",\"s5Body\":\"Sie haben das Recht auf Auskunft, Berichtigung und Löschung Ihrer Daten. Kontaktieren Sie uns unter datenschutz@solen.ch.\"}},\"partner\":{\"title\":\"Wachsen Sie mit Solen\",\"hero_title_1\":\"Ihr Salon.\",\"hero_title_accent\":\"Mehr Kunden.\",\"hero_title_2\":\"Weniger Aufwand.\",\"hero_subtitle\":\"Registrieren Sie Ihren Salon kostenlos auf solen.ch — Basels Beauty-Plattform. Online-Buchungen, Dashboard, Kundenverwaltung — alles in einem.\",\"hero_cta\":\"Kostenlos starten\",\"hero_subtext\":\"Keine Kreditkarte nötig · In 5 Minuten live\",\"form_salon_name_placeholder\":\"Ihr Salon Name\",\"form_email_placeholder\":\"E-Mail Adresse\",\"form_success_title\":\"Danke für Ihr Interesse!\",\"form_success_desc\":\"Wir melden uns in Kürze mit weiteren Infos.\",\"form_error\":\"Ein Fehler ist aufgetreten. Bitte versuchen Sie es noch einmal.\",\"alt_dashboard\":\"Solen Dashboard — Buchungskalender und Salonverwaltung\",\"alt_profile\":\"Salon-Profil auf solen.ch — so sehen Kunden Ihren Salon\",\"badge_bookings\":\"+47 Buchungen/Woche\",\"badge_rating\":\"4.8 Bewertung\",\"benefit_visibility_title\":\"Mehr Sichtbarkeit\",\"benefit_visibility_desc\":\"Erreichen Sie neue Kunden in Ihrer Umgebung. Ihr Salon erscheint auf solen.ch — Basels grösster Beauty-Plattform.\",\"benefit_bookings_title\":\"Online-Buchungen\",\"benefit_bookings_desc\":\"Kunden buchen rund um die Uhr. Sie verwalten alles in einem übersichtlichen Dashboard — weniger Telefonanrufe, mehr Termine.\",\"benefit_growth_title\":\"Wachstum \u0026 Insights\",\"benefit_growth_desc\":\"Sehen Sie, welche Services am beliebtesten sind, wann Ihre Spitzenzeiten sind, und steigern Sie Ihren Umsatz mit Last-Minute-Angeboten.\",\"features_title\":\"Alles, was Ihr Salon braucht\",\"features_subtitle\":\"Kostenlose Tools für Buchungen, Kunden und Wachstum\",\"feat_bookings_title\":\"Online-Buchungen\",\"feat_bookings_desc\":\"Kunden buchen rund um die Uhr direkt über Ihr Profil.\",\"feat_dashboard_title\":\"Dashboard\",\"feat_dashboard_desc\":\"Alle Termine, Umsätze und Statistiken auf einen Blick.\",\"feat_crm_title\":\"Kundenverwaltung\",\"feat_crm_desc\":\"Kundenhistorie, Notizen und Präferenzen gespeichert.\",\"feat_team_title\":\"Team-Verwaltung\",\"feat_team_desc\":\"Mitarbeiter einladen, Arbeitszeiten und Pausen verwalten.\",\"feat_reviews_title\":\"Bewertungen\",\"feat_reviews_desc\":\"Kundenbewertungen sammeln und direkt antworten.\",\"feat_lastminute_title\":\"Last-Minute-Deals\",\"feat_lastminute_desc\":\"Leere Slots füllen mit Rabatten — mehr Umsatz, weniger Leerlauf.\",\"feat_analytics_title\":\"Analytics\",\"feat_analytics_desc\":\"Umsatz, Spitzenzeiten und beliebte Services im Überblick.\",\"feat_reminders_title\":\"Erinnerungen\",\"feat_reminders_desc\":\"Automatische SMS- \u0026 E-Mail-Erinnerungen reduzieren No-Shows.\",\"cta_title\":\"Bereit loszulegen?\",\"cta_subtitle\":\"Die Registrierung ist kostenlos. Erstellen Sie Ihr Profil in wenigen Minuten.\",\"cta_button\":\"Jetzt Salon registrieren\",\"cta_consult\":\"Lieber eine persönliche Beratung?\",\"cta_consult_subject\":\"Beratung für Salon-Registrierung auf solen.ch\",\"pricing_title\":\"Transparent \u0026 Fair\",\"pricing_subtitle\":\"15% auf Neubuchungen · 0% auf Stammkunden. Keine versteckten Kosten, keine Verträge.\",\"pricing_badge\":\"Bestes Angebot\",\"pricing_label\":\"Provision pro Buchung\",\"pricing_per_booking\":\"pro erfolgreiche Buchung\",\"pricing_no_fixed\":\"Keine monatlichen Gebühren · Kein Vertrag · Jederzeit kündbar\",\"pricing_intro_model\":\"15% auf Neubuchungen · 0% auf Wiederkäufer\",\"pricing_intro_qualifier\":\"Einführungspreis (befristet)\",\"pricing_feature_1\":\"Unbegrenztes Salon-Profil\",\"pricing_feature_2\":\"Online-Buchungskalender\",\"pricing_feature_3\":\"Dashboard \u0026 Analytics\",\"pricing_feature_4\":\"Kundenverwaltung (CRM)\",\"pricing_feature_5\":\"Last-Minute-Angebote veröffentlichen\",\"pricing_feature_6\":\"Bewertungen \u0026 Antworten\",\"pricing_feature_7\":\"Team-Verwaltung \u0026 Einladungen\",\"pricing_feature_8\":\"SMS- \u0026 E-Mail-Erinnerungen\",\"compare_title\":\"Vergleich: Was andere Plattformen kosten\",\"compare_treatwell\":\"Treatwell \u0026 Co.\",\"compare_others\":\"Andere Plattformen\",\"compare_savings_bold\":\"Rechenbeispiel:\",\"compare_savings_text\":\"Bei CHF 1'000 Monatsumsatz über Solen sparen Sie CHF 290 pro Monat gegenüber Treatwell.\",\"faq_title\":\"Häufige Fragen\",\"faq_subtitle\":\"Alles, was Salon-Besitzer wissen möchten\",\"faq_cost_q\":\"Was kostet Solen?\",\"faq_cost_a\":\"Solen erhebt 15% Provision auf Neubuchungen und 0% auf Stammkunden. Keine monatlichen Gebühren, keine Setup-Kosten, keine versteckten Kosten. Sie zahlen nur, wenn Sie tatsächlich Kunden gewinnen.\",\"faq_contract_q\":\"Brauche ich einen Vertrag?\",\"faq_contract_a\":\"Nein. Sie können Solen jederzeit ohne Vertragsbindung nutzen und auch jederzeit pausieren oder deaktivieren — ohne Kündigungsfrist.\",\"faq_payments_q\":\"Wie funktionieren die Zahlungen?\",\"faq_payments_a\":\"Zahlungen laufen über Stripe Connect. Kunden zahlen online, und Sie erhalten den Betrag direkt auf Ihr Bankkonto. Sie können auch Zahlung im Salon oder Anzahlungen anbieten.\",\"faq_edit_profile_q\":\"Kann ich mein Profil jederzeit ändern?\",\"faq_edit_profile_a\":\"Ja, absolut. Sie können Ihr Profil, Ihre Services, Preise, Öffnungszeiten und Team jederzeit im Dashboard anpassen — in Echtzeit.\",\"faq_more_clients_q\":\"Wie bekomme ich mehr Kunden?\",\"faq_more_clients_a\":\"Ihr Salon erscheint auf solen.ch und ist für tausende Nutzer in Basel sichtbar. Zusätzlich können Sie Last-Minute-Angebote veröffentlichen und Bewertungen sammeln, um Ihre Sichtbarkeit zu steigern.\",\"faq_no_show_q\":\"Was passiert bei No-Shows?\",\"faq_no_show_a\":\"Sie können Stornierungsbedingungen festlegen — z.B. Gebühren bei kurzfristigen Absagen. Automatische SMS-Erinnerungen 24h und 1h vor dem Termin reduzieren No-Shows drastisch.\",\"faq_existing_system_q\":\"Kann ich mein bestehendes System weiter nutzen?\",\"faq_existing_system_a\":\"Ja. Solen kann parallel zu Ihrem bestehenden System laufen. Es ersetzt keine bestehende Software — es bringt Ihnen zusätzliche Kunden über unsere Plattform.\",\"faq_how_fast_q\":\"Wie schnell bin ich online?\",\"faq_how_fast_a\":\"In weniger als 5 Minuten. Registrieren Sie sich, fügen Sie Ihre Services hinzu, und Ihr Salon ist sofort auf solen.ch sichtbar. Unser Setup-Wizard führt Sie durch jeden Schritt.\",\"faq_categories_q\":\"Welche Salon-Kategorien werden unterstützt?\",\"faq_categories_a\":\"Coiffeur, Barbershop, Nagelstudio, Spa \u0026 Wellness, Makeup und Waxing. Jede Kategorie hat spezielle Features — von Nail-Portfolios bis Barber-Warteschlangen.\",\"hiw_title\":\"So funktioniert's\",\"hiw_subtitle\":\"In 3 einfachen Schritten online\",\"hiw_step1_title\":\"Registrieren\",\"hiw_step1_desc\":\"Erstellen Sie Ihr kostenloses Konto und füllen Sie Ihr Salon-Profil aus.\",\"hiw_step1_time\":\"~5 Min.\",\"hiw_step2_title\":\"Profil einrichten\",\"hiw_step2_desc\":\"Fügen Sie Services, Öffnungszeiten und Ihr Team hinzu.\",\"hiw_step2_time\":\"~10 Min.\",\"hiw_step3_title\":\"Kunden empfangen\",\"hiw_step3_desc\":\"Ihr Salon ist live — Kunden können ab sofort buchen.\",\"hiw_step3_time\":\"Sofort\",\"social_title\":\"Vertrauen \u0026 Sicherheit\",\"social_subtitle\":\"Warum Salons uns vertrauen\",\"trust_basel\":\"Basler Unternehmen\",\"trust_gdpr\":\"nDSG-konform\",\"trust_stripe\":\"Stripe-verifiziert\",\"trust_no_contract\":\"Kein Vertrag\",\"testimonial_1_quote\":\"Seit wir auf Solen sind, bekommen wir regelmässig neue Kunden aus dem Quartier. Das Dashboard ist super übersichtlich.\",\"testimonial_1_name\":\"Leila M.\",\"testimonial_1_role\":\"Inhaberin, Studio Bella Basel\",\"testimonial_1_initial\":\"L\",\"testimonial_2_quote\":\"Die Online-Buchungen haben unsere No-Show-Rate halbiert. Endlich keine verpassten Termine mehr.\",\"testimonial_2_name\":\"Marco R.\",\"testimonial_2_role\":\"Barbershop-Besitzer, Kleinbasel\",\"testimonial_2_initial\":\"M\",\"testimonial_3_quote\":\"0% auf Stammkunden — das ändert alles. Unsere Stammkunden kommen, ohne dass uns die Plattform etwas kostet.\",\"testimonial_3_name\":\"Sarah K.\",\"testimonial_3_role\":\"Nail Studio, Gundeldingen\",\"testimonial_3_initial\":\"S\",\"cat_title\":\"Für jede Salon-Kategorie\",\"cat_subtitle\":\"Spezielle Features für Ihre Branche\",\"cat_coiffeur_title\":\"Coiffeur\",\"cat_coiffeur_desc\":\"Kalender, Styling-Portfolio und Stammkunden-Verwaltung.\",\"cat_barbershop_title\":\"Barbershop\",\"cat_barbershop_desc\":\"Walk-in-Warteschlange, Cut-History und Herren-Services.\",\"cat_nails_title\":\"Nagelstudio\",\"cat_nails_desc\":\"Nail-Art-Portfolio, Material-Tracking und Design-Galerie.\",\"cat_spa_title\":\"Spa \u0026 Wellness\",\"cat_spa_desc\":\"Behandlungs-Pakete, Raum-Verwaltung und Kombi-Buchungen.\",\"cat_makeup_title\":\"Makeup\",\"cat_makeup_desc\":\"Bridal-Packages, Vorher/Nachher-Galerie und Event-Buchungen.\",\"cat_waxing_title\":\"Waxing\",\"cat_waxing_desc\":\"Zonen-basierte Preise, Behandlungs-Erinnerungen und Intervalle.\",\"sticky_cta\":\"Kostenlos starten →\",\"coming_soon\":\"Bald verfügbar\",\"for_owners\":\"Für Saloninhaber\",\"section_features\":\"Funktionen\",\"section_categories\":\"Kategorien\",\"section_how_it_works\":\"Wie es funktioniert\",\"section_testimonials\":\"Partner sagen\",\"section_pricing\":\"Preise\",\"section_faq\":\"Häufige Fragen\",\"section_start\":\"Jetzt starten\"},\"filters\":{\"filter\":\"Filter\",\"close\":\"Schliessen\",\"reset\":\"Zurücksetzen\",\"apply\":\"Anwenden\",\"closeFilter\":\"Filter schliessen\",\"moreFilters\":\"{count} weitere Filter öffnen\",\"lessFilters\":\"Weniger Filter\",\"moreFiltersToggle\":\"Mehr Filter\",\"more\":\"weitere\",\"removeFilter\":\"Filter {name} entfernen\",\"clearAll\":\"Alle entfernen\",\"location\":\"Standort\",\"availability\":\"Verfügbar\",\"rating\":\"Bewertung\",\"pickDate\":\"Datum wählen\",\"price\":\"Preis\",\"today\":\"Heute\",\"tomorrow\":\"Morgen\",\"onlinePayment\":\"Online-Zahlung\",\"offPeak\":\"Nebenzeiten\",\"sortBy\":\"Sortieren\",\"sortByRating\":\"Beliebteste\",\"sortByPrice\":\"Preis (tief → hoch)\",\"sortByNearest\":\"Nächste\",\"sortByNewest\":\"Neueste\",\"sortByNextSlot\":\"Nächster Termin\",\"filterQuartier\":\"Quartier {name} {action}\",\"filterToday\":\"Heute verfügbare Salons filtern\",\"filterTomorrow\":\"Morgen verfügb