ortTiktoks\":\"TikToks importieren\",\"imported\":\"importiert\",\"alreadyExists\":\"bereits vorhanden\",\"requestFailed\":\"Anfrage fehlgeschlagen\",\"quickImportDesc\":\"Schnellimport von Stockfotos nach Kategorie von Unsplash.\",\"importedPhotos\":\"{count} {category} Fotos importiert\",\"importFailedCategory\":\"Import von {category} fehlgeschlagen\"},\"moderation\":{\"flagged\":\"Gemeldet\",\"reason\":\"Grund\",\"approve\":\"Genehmigen\",\"remove\":\"Entfernen\"},\"errorTitle\":\"Konnte nicht laden\",\"errorMessage\":\"Prüfen Sie Ihre Verbindung und versuchen Sie es erneut.\",\"errorRetry\":\"Erneut versuchen\"},\"discovery_tos\":{\"title\":\"Nutzungsbedingungen — Discovery\",\"copyright_heading\":\"1. Urheberrecht\",\"copyright_text\":\"Sie müssen das Recht haben, die von Ihnen hochgeladenen Inhalte zu veröffentlichen. Das Hochladen urheberrechtlich geschützter Inhalte ohne Genehmigung ist verboten.\",\"license_heading\":\"2. Lizenzgewährung\",\"license_text\":\"Durch das Hochladen von Inhalten auf solen.ch gewähren Sie solen.ch eine nicht-exklusive, weltweite, gebührenfreie Lizenz zur Anzeige, Verbreitung und Bewerbung Ihrer Inhalte auf der Plattform.\",\"content_rules_heading\":\"3. Inhaltsregeln\",\"content_rules_text\":\"Verbotene Inhalte: Nacktheit, Hassrede, Gewalt, Spam, irreführende Informationen, Inhalte die Minderjährige darstellen. Verstösse führen zur sofortigen Entfernung und möglicherweise zur Sperrung des Kontos.\",\"removal_heading\":\"4. Inhaltsentfernung\",\"removal_text\":\"solen.ch behält sich das Recht vor, Inhalte ohne Vorankündigung zu entfernen, die gegen diese Bedingungen verstossen oder anderweitig unangemessen sind.\",\"gdpr_heading\":\"5. DSGVO-Konformität\",\"gdpr_text\":\"Hochgeladene Inhalte werden auf Servern in der EU/Schweiz gespeichert. Sie können die Löschung Ihrer Inhalte jederzeit über Ihre Profileinstellungen oder per E-Mail an support@solen.ch beantragen.\",\"disclaimer_heading\":\"6. Haftungsausschluss\",\"disclaimer_text\":\"solen.ch übernimmt keine Garantie für die Genauigkeit von KI-generierten Beschreibungen. Die angezeigten Preise sind Schätzungen und können je nach Salon variieren.\"},\"nail\":{\"options_title\":\"Nail-Optionen\",\"material\":\"Material\",\"shape\":\"Nagelform\",\"length\":\"Nagellänge\",\"shape_round\":\"Rund\",\"shape_square\":\"Square\",\"shape_oval\":\"Oval\",\"shape_almond\":\"Mandel\",\"shape_coffin\":\"Coffin\",\"shape_stiletto\":\"Stiletto\",\"shape_squoval\":\"Squoval\",\"shape_ballerina\":\"Ballerina\",\"shape_lipstick\":\"Lipstick\",\"shape_edge\":\"Edge\",\"length_natural\":\"Natürlich\",\"length_short\":\"Kurz\",\"length_medium\":\"Mittel\",\"length_long\":\"Lang\",\"length_extra_long\":\"Extra Lang\",\"material_gel\":\"Gel\",\"material_acrylic\":\"Acryl\",\"material_shellac\":\"Shellac\",\"material_dip_powder\":\"Dip Powder\",\"material_poly_gel\":\"Polygel\",\"material_press_on\":\"Press-On\",\"material_natural\":\"Naturlack\",\"repeat_last\":\"Letztes Design wiederholen\",\"inspo_upload\":\"Inspiration hochladen\",\"inspo_board\":\"Aus Board wählen\",\"inspo_select_count\":\"{count} Bilder auswählen\",\"allergy_warning\":\"Allergie-Hinweis\",\"allergy_severe\":\"Schwere Allergie\",\"allergy_against\":\"Allergie gegen {allergies} — bitte informiere das Nagelstudio\",\"station_available\":\"Noch {available} von {total} Plätzen verfügbar\",\"tier_artist\":\"{tier} Nail Artist\",\"portfolio\":\"Portfolio\",\"design_history\":\"Design-Verlauf\",\"preferences\":\"Präferenzen\",\"client_notes\":\"Notizen\",\"tags\":\"Tags\",\"repeat_design\":\"Wiederholen\",\"publish_to_discovery\":\"Auf Discovery veröffentlichen\",\"infill_reminder\":\"Auffüll-Erinnerung\",\"infill_due\":\"Auffüllung fällig\",\"stations_manage\":\"Stationen verwalten\",\"station_count\":\"Anzahl Stationen\",\"uv_lamps\":\"UV-Lampen\",\"sterilization_buffer\":\"Sterilisations-Puffer (Min.)\",\"current_occupancy\":\"Aktuelle Auslastung\",\"discovery_title\":\"Nail Inspiration\",\"dis