# =============================================================================
# Solen.ch — Environment Variables Reference
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.
# =============================================================================

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Get from: Supabase Dashboard → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Email — Resend (required for all transactional emails) ---
# Get from: resend.com → API Keys → Create API Key
# Domain solen.ch must be verified in Resend before emails will deliver
RESEND_API_KEY=your-resend-api-key-here

# --- Admin notifications ---
# Email address that receives admin alerts (disputes, new salons, etc.)
ADMIN_EMAIL=admin@solen.ch

# --- Error Tracking — Sentry ---
# Get from: sentry.io → Project Settings → Client Keys (DSN)
SENTRY_DSN=https://your-dsn@sentry.io/your-project-id
# Get from: sentry.io → Settings → Auth Tokens (for source map uploads)
SENTRY_AUTH_TOKEN=your-sentry-auth-token-here

# --- Analytics — PostHog (EU Cloud for GDPR/Swiss compliance) ---
# Get from: eu.posthog.com → Project Settings → Project API Key
NEXT_PUBLIC_POSTHOG_KEY=phc_your-posthog-key-here
POSTHOG_PERSONAL_API_KEY=phpat_your-personal-api-key-here
POSTHOG_PROJECT_ID=your-project-id-here

# --- Payments — Stripe ---
# Get from: dashboard.stripe.com → Developers → API Keys
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key-here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your-stripe-publishable-key-here
# Get from: dashboard.stripe.com → Developers → Webhooks → signing secret
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-here

# --- Directory Data — Google Places API ---
# Get from: console.cloud.google.com → APIs → Places API → Credentials
GOOGLE_PLACES_API_KEY=your-google-places-api-key-here

# --- Rate Limiting — Upstash Redis ---
# Get from: console.upstash.com → Redis → Create Database (choose EU-West for latency)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token-here

# --- AI — Anthropic Claude API (for Visual Editor roadmap generation) ---
# Get from: console.anthropic.com → API Keys → Create
# Required for: /api/admin/generate-roadmap
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- AI — Google Gemini (for Discovery AI vision + descriptions) ---
# Get from: aistudio.google.com → API Keys
# Required for: /api/admin/discovery/analyze, /api/discovery/generate-description
GEMINI_API_KEY=your-gemini-api-key-here

# --- Platform Config (Mega-Build) ---
# Platform fee percentage charged per booking (1 = 1%)
PLATFORM_FEE_PERCENT=1
# HMAC secrets for tokenized booking links (quick-action, walk-in payment)
# Generate with: openssl rand -hex 32
BOOKING_HMAC_SECRET=your-hmac-secret-here
# HMAC secret for gift card QR code validation
GIFT_CARD_HMAC_SECRET=your-gc-hmac-secret-here

# --- SMS — seven.io (for walk-in payment links, birthday messages) ---
# Get from: app.seven.io → Settings → HTTP API
SEVEN_API_KEY=your-seven-api-key-here

# --- Discovery — Stock Photo APIs (optional, for admin content import) ---
# Get from: unsplash.com/developers → Your Apps → Access Key
UNSPLASH_ACCESS_KEY=your-unsplash-access-key-here
# Get from: pexels.com/api → Your API Key
PEXELS_API_KEY=your-pexels-api-key-here
# Get from: pixabay.com/api/docs → Your API Key
PIXABAY_API_KEY=your-pixabay-api-key-here

