# ═══════════════════════════════════════════════
# Solen.ch — Required Environment Variables
# Copy this file to .env.local for local dev
# Also ensure all vars are set in Vercel Dashboard
# ═══════════════════════════════════════════════

# ── Supabase (REQUIRED) ──────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Stripe (REQUIRED for payments) ───────────
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Mapbox (REQUIRED for map) ────────────────
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ...

# ── Gemini AI (REQUIRED for AI features) ─────
GEMINI_API_KEY=AIza...

# ── Resend (REQUIRED for emails) ─────────────
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@solen.ch

# ── Upstash Redis (REQUIRED for rate limiting) ──
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=AX...

# ── PostHog (analytics, optional) ────────────
NEXT_PUBLIC_POSTHOG_KEY=phc_...
POSTHOG_PERSONAL_API_KEY=phx_...
POSTHOG_PROJECT_ID=

# ── Google Places (salon address lookup) ─────
GOOGLE_PLACES_API_KEY=AIza...

# ── Stock Photos (optional) ──────────────────
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ── SMS via seven.io (optional) ──────────────
SEVEN_IO_API_KEY=

# ── Cron Jobs (REQUIRED for scheduled tasks) ──
CRON_SECRET=

# ── Loyalty (optional) ──────────────────────
LOYALTY_HMAC_SECRET=

# ── Site URL ─────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.solen.ch
NEXT_PUBLIC_APP_URL=https://www.solen.ch

# ── Admin ────────────────────────────────────
ADMIN_EMAIL=admin@solen.ch
