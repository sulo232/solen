# =============================================================================
# Solen.ch — Environment Variables Reference
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.
# =============================================================================

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Get from: Supabase Dashboard → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Email — Resend (required for all transactional emails) ---
# Get from: resend.com → API Keys → Create API Key
# Domain solen.ch must be verified in Resend before emails will deliver
RESEND_API_KEY=your-resend-api-key-here

# --- Admin notifications ---
# Email address that receives admin alerts (disputes, new salons, etc.)
ADMIN_EMAIL=admin@solen.ch

# --- Error Tracking — Sentry ---
# Get from: sentry.io → Project Settings → Client Keys (DSN)
SENTRY_DSN=https://your-dsn@sentry.io/your-project-id
# Get from: sentry.io → Settings → Auth Tokens (for source map uploads)
SENTRY_AUTH_TOKEN=your-sentry-auth-token-here

# --- Analytics — PostHog (EU Cloud for GDPR/Swiss compliance) ---
# Get from: eu.posthog.com → Project Settings → Project API Key
NEXT_PUBLIC_POSTHOG_KEY=phc_your-posthog-key-here

# --- Payments — Stripe ---
# Get from: dashboard.stripe.com → Developers → API Keys
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key-here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your-stripe-publishable-key-here
# Get from: dashboard.stripe.com → Developers → Webhooks → signing secret
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-here

# --- Directory Data — Google Places API ---
# Get from: console.cloud.google.com → APIs → Places API → Credentials
GOOGLE_PLACES_API_KEY=your-google-places-api-key-here

# --- Rate Limiting — Upstash Redis ---
# Get from: console.upstash.com → Redis → Create Database (choose EU-West for latency)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token-here

