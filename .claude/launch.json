{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Next.js dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "autoPort": true
    },
    {
      "name": "Design preview (static)",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["--yes", "serve", "public", "--no-clipboard", "--listen", "3000"],
      "port": 3000,
      "autoPort": false
    },
    {
      "name": "Supabase local stack",
      "runtimeExecutable": "supabase",
      "runtimeArgs": ["start"],
      "port": 54321
    },
    {
      "name": "Supabase Edge Functions",
      "runtimeExecutable": "supabase",
      "runtimeArgs": ["functions", "serve"],
      "port": 54321
    }
  ]
}
